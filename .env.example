# Copy to .env and fill in before running docker compose up.
# .env is gitignored, never commit real secrets.

# Required. Generate a strong random value, e.g.: openssl rand -base64 32
PAYLOAD_SECRET=

# Required only when running npm run seed. Choose a unique admin password.
SEED_ADMIN_PASSWORD=

# Public URL this site is reachable at (used for metadata/OG tags).
# Update once a real domain / reverse-proxy route is in front of it.
NEXT_PUBLIC_SERVER_URL=http://localhost:3090

# Host port to bind to. Change if 3090 is already taken on this host
# (check with: docker ps --format "{{.Names}}: {{.Ports}}").
WEB_PORT=3090

# Optional. TikTok Display API app (developers.tiktok.com) with Login Kit and the
# user.info.basic + video.list scopes. Register this redirect URI on the app:
#   <NEXT_PUBLIC_SERVER_URL>/connect/tiktok/callback   (must be public HTTPS)
# Then connect the account in Admin -> TikTok Connection.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
